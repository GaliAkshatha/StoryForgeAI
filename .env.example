# ---------------------------------------------------------------
# LLM Provider (v2.0: Gemini is the default)
# ---------------------------------------------------------------
# DependencyContainer is the ONLY place that reads LLM_PROVIDER --
# no agent, prompt, or service ever knows which provider is active.
# Defaults to "gemini" if unset. Set to "ollama" for a fully
# local/offline setup.

LLM_PROVIDER=gemini

GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------
# Optional: Ollama (local provider + always used for embeddings)
# ---------------------------------------------------------------
# Ollama remains fully supported as an LLM_PROVIDER=ollama choice.
# It is ALSO always used for Hybrid RAG embeddings regardless of
# LLM_PROVIDER, since nomic-embed-text is Ollama-only per the
# mandatory AI Stack (MASTER_PROMPT.md).

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ChromaDB server for the vector store half of Hybrid RAG. If unset,
# the platform falls back to an in-memory vector store (fine for
# local dev; not persistent).
CHROMA_BASE_URL=http://localhost:8000
CHROMA_COLLECTION=storyforge_knowledge

# API server
PORT=4000

# ---------------------------------------------------------------
# Persistence (v2.0: PostgreSQL via Prisma is the default)
# ---------------------------------------------------------------
# Set PERSISTENCE=memory to fall back to the original in-memory
# repositories for local dev/tests without a database. Data does not
# survive a restart in that mode.

PERSISTENCE=postgres
DATABASE_URL=postgresql://storyforge:storyforge@localhost:5432/storyforge

# ---------------------------------------------------------------
# Parent authentication (v2.0: bcrypt + JWT)
# ---------------------------------------------------------------
# JWT_SECRET is required -- the API refuses to start without it.
# Generate one with: openssl rand -base64 48

JWT_SECRET=replace_with_a_long_random_secret
JWT_TTL_SECONDS=604800
