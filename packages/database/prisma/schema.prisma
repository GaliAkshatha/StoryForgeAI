// StoryForge Prisma schema. Models here mirror the domain models in
// packages/identity, packages/parent, packages/child, and
// packages/learning exactly -- this file has no business logic of
// its own, it only describes how those domain shapes are persisted.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Identity domain -------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  // bcrypt hash string (embeds its own salt + cost factor -- no
  // separate passwordSalt column needed, unlike v1's scrypt hasher).
  passwordHash String

  // BYOK (Part 4): AES-256-GCM encrypted Gemini API key -- see
  // ApiKeyEncryption. Never the plaintext key, never returned to the
  // frontend once saved (routes only ever report connected/not).
  geminiApiKeyEncrypted String?

  createdAt    DateTime @default(now())

  @@map("users")
}

// --- Parent domain -----------------------------------------------

model ParentProfile {
  id                       String   @id @default(uuid())
  userId                   String   @unique
  displayName              String
  childIds                 String[] @default([])
  weeklyReportEmailEnabled Boolean  @default(true)
  dailyPlayLimitMinutes    Int      @default(30)
  createdAt                DateTime @default(now())

  @@map("parent_profiles")
}

// --- Child domain --------------------------------------------------

model ChildProfile {
  id                String   @id @default(uuid())
  parentId          String
  name              String
  ageRange          String
  readingLevel      String
  vocabularyLevel   String
  avatarId          String
  aboutChild        String?
  adventureWorldIds String[] @default([])
  createdAt         DateTime @default(now())

  @@index([parentId])
  @@map("child_profiles")
}

// --- Simulation domain: persistent World State (v2.0) ---------------
//
// One row per adventure. inventory/relationships/quests/economy/flags
// are stored as Json to mirror the WorldState domain model in
// simulation-engine exactly -- this table has no shape of its own
// beyond what that model already defines.

model WorldStateRecord {
  worldId           String   @id
  childId           String
  turn              Int
  location          String
  inventory         Json
  relationships     Json
  quests            Json
  economy           Json
  flags             Json
  moral             String   @default("")
  domain            String   @default("")
  currentNarrative  String   @default("")
  currentChoices    Json     @default("[]")
  // v3 Story Graph link -- links this WorldState to the Adventure/
  // StoryNode it's currently walking. Added to the WorldState domain
  // model when the graph-based runtime was introduced, but this
  // schema (and PostgresWorldStateStore's mapping) was never updated
  // to match -- a real, pre-existing bug: adventureId/currentNodeId
  // were silently dropped on every Postgres round-trip, causing
  // AdventureRuntime.playTurn() to fail on the very next request
  // after a fresh (non-memory-mode) create().
  adventureId       String?
  currentNodeId     String?
  // Chapter lifecycle correction pass: deterministic chapter
  // progression state (turn/phase/meaningfulEvents/climaxReached).
  // Nullable Json, same pattern as pendingRenderRequest on
  // StoryNodeRecord -- Prisma.DbNull represents "no chapter state
  // tracked" (code paths unrelated to the graph runtime), not a
  // JSON-null value.
  chapterState      Json?
  // Phase 2A: persistent story facts (location/active characters/
  // goal/problem/facts/threads). Same nullable-Json pattern as
  // chapterState/pendingRenderRequest -- Prisma.DbNull for "not
  // tracked" (backward-compat with pre-Phase-2A records).
  narrativeState    Json?
  updatedAt         DateTime

  @@index([childId])
  @@map("world_states")
}

// One row per adventure turn -- the durable transcript that used to
// live only in AdventureRuntime's in-memory Map.

model StoryTurnRecord {
  id                   String   @id @default(uuid())
  worldId              String
  sessionId            String
  childId              String
  situationText        String
  decisionText         String
  consequenceNarrative String
  reflectionQuestion   String?
  learningSignals      String[] @default([])
  createdAt            DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([worldId])
  @@map("story_turns")
}
// --- Learning domain -----------------------------------------------
//
// One row per Analytics Agent run (one per adventure turn). The
// Learning domain's WeeklyReport is computed on read by aggregating
// these rows -- this table is the raw, append-only observation log,
// never edited after insert.

model LearningAnalyticsRecord {
  id            String   @id @default(uuid())
  sessionId     String
  childId       String
  // SkillSignal[] -- { skill, observation, delta }[]
  skillSignals  Json
  behaviorNotes String[]
  summary       String
  generatedAt   DateTime

  @@index([childId, generatedAt])
  @@map("learning_analytics_records")
}

// --- Story Graph domain (v3) -----------------------------------------
//
// Part 1's "New Runtime": one Adventure blueprint row plus many
// StoryNode rows (one per graph vertex), generated once up front by
// AdventureBlueprintGenerator. Gameplay after that is pure
// AdventureId+nodeId lookups and edge traversal -- no further LLM
// calls. StoryNode is a separate table (not nested JSON on
// Adventure) specifically so background expansion can INSERT new
// nodes into an existing graph later without a read-modify-write of
// one giant blob.

model AdventureRecord {
  id            String   @id @default(uuid())
  childId       String
  title         String
  moral         String
  domain        String
  characters    Json
  world         Json
  learningPlan  Json
  emotionCurve  Json
  genome        Json     @default("{}")
  // Correction pass: short non-prose seed phrase for the root
  // node's opening narration -- see Adventure.premise.
  premise       String   @default("")
  // Stabilization pass: distinct short situation phrase -- see
  // Adventure.initialProblem.
  initialProblem String  @default("")
  // Story arc pass: the authored 5-beat plot outline.
  plotOutline    Json    @default("[]")
  rootNodeId    String
  createdAt     DateTime @default(now())

  @@index([childId])
  @@map("adventures")
}

model StoryNodeRecord {
  // id is the LLM-chosen node id (e.g. "root", "left-path") and is
  // only unique WITHIN one adventure's graph, not globally -- so the
  // primary key is the (adventureId, id) pair, not id alone.
  id               String
  adventureId      String
  narrative        String
  // StoryChoice[] -- { id, text, nextNodeId, requiresFlags? }[]
  choices          Json
  learningSignals  String[] @default([])
  // EmotionProfile -- { excitement, curiosity, confidence, fear, wonder, frustration, pride, calm }
  emotion          Json
  // StateEffect[]
  effects          Json
  difficulty       Int
  readingLevel     String
  isEnding         Boolean  @default(false)
  endingType       String?
  // The following four fields were added to the StoryNode domain
  // model during the lazy-narration and correction-pass work but
  // never propagated to this schema -- the exact same class of bug
  // as WorldState.adventureId/currentNodeId earlier. eventType feeds
  // AdventureEvent/analytics logging; targetCharacterId/Name feed
  // NPC memory logging; pendingRenderRequest is what
  // NarrationRenderingService needs to lazily render a node -- its
  // absence is what caused "node has no narrative and no
  // pendingRenderRequest" on a real Postgres round-trip.
  eventType           String?
  targetCharacterId   String?
  targetCharacterName String?
  pendingRenderRequest Json?
  // Phase 2A: carries the SemanticEvent's consequence/thread
  // content so NarrativeStateTransition can apply it deterministically
  // when this node is actually visited.
  narrativeConsequence String?
  // Phase 2B (Section B): explicit character-introduction signal --
  // distinct from targetCharacterId/Name.
  characterIntroducedId   String?
  characterIntroducedName String?
  threadIntroduced     String?
  threadResolved       String?
  createdAt        DateTime @default(now())

  @@id([adventureId, id])
  @@index([adventureId])
  @@map("story_nodes")
}

// v3 Part 3: Reflection/Analytics Engines read from these instead of
// calling an LLM every turn. Derived deterministically from a
// StoryNode's eventType at the moment of arrival -- see
// AdventureRuntime.

model AdventureEventRecord {
  id          String   @id @default(uuid())
  worldId     String
  sessionId   String
  childId     String
  adventureId String
  nodeId      String
  eventType   String
  narrative   String
  emotion     Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([sessionId, createdAt])
  @@map("adventure_events")
}

// Phase 9: dedicated emotion history, recorded every turn (not just
// eventType-tagged ones), scoped per child across their whole
// history rather than one session.

model EmotionStateRecord {
  id        String   @id @default(uuid())
  childId   String
  sessionId String
  worldId   String
  emotion   Json
  recordedAt DateTime @default(now())

  @@index([childId, recordedAt])
  @@index([sessionId, recordedAt])
  @@map("emotion_states")
}

// Phase 10: durable log behind WorldState.relationships' numeric
// trust/affinity -- "why" a relationship is where it is.

model NpcMemoryRecord {
  id            String   @id @default(uuid())
  childId       String
  worldId       String
  characterId   String
  characterName String
  eventType     String
  description   String
  createdAt     DateTime @default(now())

  @@index([worldId, characterId])
  @@map("npc_memory")
}

// Phases 2/8/13: deterministically-unlocked milestones.

model AchievementRecord {
  id         String   @id @default(uuid())
  childId    String
  key        String
  title      String
  description String
  unlockedAt DateTime @default(now())

  @@unique([childId, key])
  @@index([childId])
  @@map("achievements")
}
