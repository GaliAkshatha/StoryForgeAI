{
  "name": "@storyforge/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "prisma studio",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@storyforge/identity": "workspace:*",
    "@storyforge/parent": "workspace:*",
    "@storyforge/child": "workspace:*",
    "@storyforge/learning": "workspace:*",
    "@storyforge/simulation-engine": "workspace:*",
    "@storyforge/story-graph": "workspace:*",
    "@storyforge/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "prisma": "^6.2.1",
    "typescript": "^6.0.3"
  }
}
